# Address on which Docker publishes the UI, SIP and RTP. Use the host's
# Tailscale IPv4 address; do not use 0.0.0.0 here.
VITI_BIND_IP=100.64.0.10
# Host-side HTTP port. It is configurable because Windows/Hyper-V may reserve
# otherwise common ports; the manager still listens on 0.0.0.0:8787 in Docker.
VITI_HTTP_PORT=18787
VITI_LOCAL_HTTP_PORT=18788
# Explicit non-overlapping container network. Docker Desktop commonly assigns
# 172.23.0.0/16, which can collide with the Windows/WSL host interface.
VITI_DOCKER_SUBNET=172.31.250.0/24
# Absolute host directory outside this repository. Merely setting this path
# does not enable capture; set the explicit switch below for a diagnostic run.
VITI_DIAGNOSTICS_DIR=C:/path/to/viti-operator-diagnostics
# Opt-in, unredacted, high-volume tracing. Keep disabled for normal operation.
VITI_DIAGNOSTICS_ENABLED=0

# Generate independent random values, for example: openssl rand -hex 32
VITI_API_KEY=replace-with-a-random-api-key
VITI_ENGINE_EVENT_TOKEN=replace-with-a-random-engine-token
VITI_AMI_SECRET=replace-with-a-random-ami-secret
VITI_VOICE_PASSWORD=replace-with-a-random-webrtc-password
# Set to 0 only when no trusted integration should be allowed to attach media.
VITI_SERVICE_MEDIA_ENABLED=1
# Ordered stable integration names, for example: metadata-filter,voice-check
VITI_SCREENING_PIPELINE=

# Public line metadata. These are not SIM cryptographic secrets.
VITI_LINE_NUMBER=+34123456789
VITI_IMS_REALM=ims.mnc000.mcc000.3gppnetwork.org

# openstick | remote | command | disabled
VITI_SIM_AUTH_TYPE=openstick
VITI_ADB_SERIAL=replace-with-adb-serial
VITI_ANDROID_AGENT=phone

# For OpenStick, expose the host ADB server only over an interface reachable by
# Docker. On Windows use the private bridge documented in README.md; never run
# `adb -a` on an untrusted network.
VITI_ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
